# Copy to .env and fill in the keys your character uses.
# OpenAI: the chat model and the director extension
OPENAI_API_KEY=
# ElevenLabs: speech to text and the character's voice
ELEVENLABS_API_KEY=
# Typesafe: the memory and reactions extensions, for a character that uses them
# TYPESAFE_API_KEY=

# Optional: the command that opens the player app, so `npm start` opens it too.
# Run by the shell from this folder, like the path to the player binary; it
# must keep running while the player is open (on macOS, the binary inside the
# .app, not `open -a`).
# HARNESS_PLAYER=path/to/player
# with the macOS release: HARNESS_PLAYER="'/Applications/Character Player.app/Contents/MacOS/'*"
# with a Windows release (keep both quote levels for paths with spaces):
# HARNESS_PLAYER='"C:/Users/you/Apps/character-player-0.1.0-windows-x64/Character Player.exe"'
# or, with your own build: HARNESS_PLAYER="cd player && hz/hzbuild macos run"

# Optional: what the session socket listens on. 0.0.0.0 also serves a player on
# another device, like an iPhone on the same network; 127.0.0.1 (the default)
# keeps it to this machine.
# HOST=0.0.0.0

# Optional: a fixed session token. Unset, a new one is minted on every start,
# which is what a player launched with the runtime always wants. Set it when a
# player has to find the session on its own, like the iOS app opened from the
# home screen: it remembers the url it was last handed, so the token must stay
# the same across restarts for that url to keep working.
# HARNESS_TOKEN=
